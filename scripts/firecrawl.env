# Self-hosted Firecrawl configuration for the NInfer web-search proxy.
# setup-firecrawl.sh copies this to firecrawl/.env and replaces
# __POSTGRES_PASSWORD__ and __BULL_AUTH_KEY__ with random values.

PORT=3002
HOST=0.0.0.0

# Self-hosted: no Firecrawl cloud account, no API-key checks.
USE_DB_AUTHENTICATION=false

# PostgreSQL (container-local; not published to the host).
# POSTGRES_DB must stay 'postgres': nuq-postgres installs pg_cron, which only
# builds in the database named by cron.database_name.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=postgres

# Queue admin UI key.
BULL_AUTH_KEY=__BULL_AUTH_KEY__

# Concurrency. This host has 128 GB of system RAM and the model lives in VRAM,
# so Firecrawl can be less frugal than on a unified-memory machine.
BROWSER_POOL_SIZE=4
MAX_CONCURRENT_JOBS=2
CRAWL_CONCURRENT_REQUESTS=6
NUM_WORKERS_PER_QUEUE=1

# Firecrawl's own AI features (/extract, JSON formatting) run against the local
# ninfer-serve instead of a third-party API. host.docker.internal resolves
# through the extra_hosts entry in Firecrawl's docker-compose.yaml.
OPENAI_BASE_URL=http://host.docker.internal:8080/v1
OPENAI_API_KEY=welcome
MODEL_NAME=qwen3.8-27b

# /search backend. With nothing set, Firecrawl uses DuckDuckGo, which needs no
# key. For a fully self-hosted search index, run SearXNG and point at it:
# SEARXNG_ENDPOINT=http://host.docker.internal:8081
